# Copy to .env and fill in. Nothing here is required — a check with no
# config is skipped. Never commit your real .env.

# Wallets to watch for low gas: name:0xaddress, comma-separated.
# WATCH_WALLETS="hot:0x...,cold:0x..."
# ...or point at a JSON file {"name": "0x..."} instead:
# WALLETS_FILE=wallets.json

# RPC endpoint for balance checks (defaults to public Base RPC).
# BASE_RPC_URL=https://mainnet.base.org
# If ALCHEMY_API_KEY is set and BASE_RPC_URL is not, the Alchemy Base URL is used.
# ALCHEMY_API_KEY=

# ETH balance below this triggers a WARNING (default 0.0005).
# GAS_THRESHOLD_ETH=0.0005

# Processes to watch: name:pattern, comma-separated (matched with pgrep -f).
# CHECK_PROCESSES="worker:venv/bin/python.*worker.py,api:uvicorn.*app:app"

# API key env vars that must be set (comma-separated).
# REQUIRED_API_KEYS=GROQ_API_KEY,MISTRAL_API_KEY,OPENROUTER_API_KEY,CEREBRAS_API_KEY,NVIDIA_API_KEY

# Where JSONL alerts are written (default logs/alert-bot.jsonl next to the script).
# ALERT_LOG=logs/alert-bot.jsonl
